# BEGIN neoteletext (~/devel/neoteletext-app-server/deploy/ionos/deploy.sh
# replaces everything to END). The neoteletext nspawn container, with its own
# network namespace. app.neottx.com, the NeoTeletext server, ends TLS in the
# server itself: caddyrouter passes the name's TCP connections through, still
# encrypted, with the viewer's address in a PROXY protocol version 2 header,
# by the layer 4 listener wrapper in its global options
# (caddyrouter-global.caddy, DEC-6972), and the host forwards UDP 443 to the
# server, which ends HTTP/3 too (DEC-6978). This block's app.neottx.com site
# is reached by no viewer: it stays so that Caddy keeps renewing the name's
# certificate, which the server is given. The other names go to Caddy
# inside the container at 10.70.0.18:8080: the static site on www.neottx.com
# and the redirects from neottx.com and the neoteletext.com names.
(neoteletext_log) {
	log {
		output file /var/log/caddy/neoteletext.com.log {
			roll_size 10MB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}
}
# The server keys its per-address limits on the viewer's address, which it
# takes from the PROXY version 2 header this Caddy, its trusted proxy
# (--trusted-proxy 10.70.0.17 --proxy-protocol), writes before TLS; it reads
# no X-Forwarded-For then.
app.neottx.com {
	reverse_proxy https://10.70.0.18:8090 {
		transport http {
			# HTTP/1.1 to the server: Caddy hands a WebSocket it took by extended
			# CONNECT upstream as an HTTP/1.1 Upgrade, which HTTP/2 cannot carry.
			versions 1.1
			tls_server_name app.neottx.com
			proxy_protocol v2
		}
	}
	encode zstd gzip
	import neoteletext_log
}
neottx.com, www.neottx.com, neoteletext.com, www.neoteletext.com, app.neoteletext.com {
	reverse_proxy http://10.70.0.18:8080
	encode zstd gzip
	import neoteletext_log
}
# END neoteletext
